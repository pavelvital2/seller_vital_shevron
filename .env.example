# Copy to .env locally if needed. Do not commit real values.

# Project identity
PROJECT_OWNER=Vital Shevron
SELLER_SKU_MODE=separate

# Ozon Seller API
OZON_SELLER_CLIENT_ID=
OZON_SELLER_API_KEY=

# Optional: read Ozon Seller credentials from a two-line file:
# line 1 - Client-Id, line 2 - Api-Key
VITAL_SHEVRON_OZON_SELLER_CREDENTIALS_FILE=/home/pavel/projects/seller_vital_shevron/.sessions/ozon/ozon_seller_api_credentials.txt

# Ozon Performance API
OZON_PERFORMANCE_CLIENT_ID=
OZON_PERFORMANCE_CLIENT_SECRET=
VITAL_SHEVRON_OZON_PERFORMANCE_CREDENTIALS_FILE=/home/pavel/projects/seller_vital_shevron/.sessions/ozon/ozon_performance_api_credentials.txt

# Wildberries API
WB_API_TOKEN=
VITAL_SHEVRON_WB_TOKEN_FILE=/home/pavel/projects/seller_vital_shevron/.sessions/wb/wb_api_token.txt

# LK/session defaults. These are not secrets.
OZON_REMOTE_DEBUGGING_PORT=9544
OZON_EXPECTED_STORE=Vital Shevron
OZON_WATCHDOG_INTERVAL_SECONDS=1800
WB_EXPECTED_SELLER=
WB_WATCHDOG_INTERVAL_SECONDS=3600

# Temporary compatibility note:
# the code package is still named takterra_agent at transfer phase 1.
# Legacy TAKTERRA_* credential file variables are still accepted as fallback,
# but new Vital Shevron setups should use VITAL_SHEVRON_* names above.
