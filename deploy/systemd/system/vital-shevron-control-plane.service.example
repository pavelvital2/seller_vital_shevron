[Unit]
Description=Vital Shevron owner control bot and Mini App API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pavel
Group=pavel
WorkingDirectory=/home/pavel/projects/seller_vital_shevron
Environment=PYTHONPATH=/home/pavel/projects/seller_vital_shevron/src
EnvironmentFile=/home/pavel/projects/seller_vital_shevron/deploy/env/vital-shevron-control-plane.env
ExecStart=/home/Codex/agent-tools/python/bin/python -m seller_agent.control_plane --runtime-db runtime/runtime.db --data-dir data
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=tmpfs
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
BindReadOnlyPaths=-/home/pavel/projects/seller_vital_shevron
BindPaths=-/home/pavel/projects/seller_vital_shevron/runtime
BindPaths=-/home/pavel/projects/seller_vital_shevron/.sessions/telegram
BindReadOnlyPaths=-/home/pavel/.secrets/vital_shevron_control_bot_token
BindReadOnlyPaths=-/home/pavel/.secrets/vital_shevron_control_session_secret
BindReadOnlyPaths=-/home/Codex/agent-tools/python
InaccessiblePaths=-/home/pavel/.ssh
InaccessiblePaths=-/home/pavel/.codex
InaccessiblePaths=-/home/pavel/.config
InaccessiblePaths=-/home/pavel/.local
InaccessiblePaths=-/home/pavel/.secrets/vital_shevron_telegram_bot_token
InaccessiblePaths=-/home/pavel/projects/seller_vital_shevron/.env
InaccessiblePaths=-/home/pavel/projects/seller_vital_shevron/.sessions/ozon
InaccessiblePaths=-/home/pavel/projects/seller_vital_shevron/.sessions/wb
InaccessiblePaths=-/home/pavel/projects/seller_vital_shevron/.sessions/telegram/vital_shevron_telegram_bot.env
InaccessiblePaths=-/home/pavel/.parser-data-api.env
UnsetEnvironment=OZON_SELLER_CLIENT_ID OZON_SELLER_API_KEY OZON_PERFORMANCE_CLIENT_ID OZON_PERFORMANCE_CLIENT_SECRET WB_API_TOKEN VITAL_SHEVRON_OZON_SELLER_CREDENTIALS_FILE VITAL_SHEVRON_OZON_PERFORMANCE_CREDENTIALS_FILE VITAL_SHEVRON_WB_TOKEN_FILE SELLER_OZON_SELLER_CREDENTIALS_FILE SELLER_OZON_PERFORMANCE_CREDENTIALS_FILE SELLER_WB_TOKEN_FILE PARSER_DATA_API_TOKEN

[Install]
WantedBy=multi-user.target
